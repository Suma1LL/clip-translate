#!/usr/bin/env python3
# clip-translate-watch: 订阅 GPaste 剪贴板事件 → 复制英文自动弹翻译窗口（passive 模式，不抢焦点）
# systemd user service: clip-translate-watch.service
import os, re, signal, subprocess
from gi.repository import Gio, GLib

GUI = os.path.expanduser('~/.local/bin/clip-translate-gui')
PID_FILE = '/tmp/clip-translate-gui.pid'
ENABLED_FILE = os.path.expanduser('~/.config/clip-translate.enabled')
DEST, PATH, IFACE = 'org.gnome.GPaste', '/org/gnome/GPaste', 'org.gnome.GPaste2'
MAX_LEN = 5000


def is_enabled():
    """总开关：状态文件为 0 时暂停自动翻译（缺省开启，手动 Super+T 不受影响）"""
    try:
        return open(ENABLED_FILE).read().strip() != '0'
    except (OSError, ValueError):
        return True


def is_english(t):
    return bool(re.search(r'[A-Za-z]', t)) and not re.search(r'[一-鿿]', t)


bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)


def ensure_daemon():
    """GPaste daemon 是 D-Bus activatable，调用一次确保常驻；每 60s 保活。"""
    try:
        bus.call_sync(DEST, PATH, IFACE, 'GetHistoryName', None, None,
                      Gio.DBusCallFlags.NONE, -1, None)
    except Exception:
        pass
    return True


def latest_text():
    res = bus.call_sync(DEST, PATH, IFACE, 'GetElementAtIndex',
                        GLib.Variant('(t)', (0,)), None,
                        Gio.DBusCallFlags.NONE, -1, None)
    return (res.unpack()[1] or '') if res else ''


def on_update(conn, sender, path, iface, sig_name, params):
    if not is_enabled():
        return
    vals = params.unpack() if params else ()
    if not vals or vals[0] != 'REPLACE':
        return
    try:
        text = latest_text().strip()
    except Exception:
        return
    if text and len(text) <= MAX_LEN and is_english(text):
        # 单窗口体验：按 PID 精确关旧窗口再弹新的（不用 pkill -f，避免误杀无关进程）
        try:
            old_pid = int(open(PID_FILE).read().strip())
            os.kill(old_pid, signal.SIGTERM)
        except Exception:  # 杀旧窗口失败（PID过期/文件缺失）不影响弹新窗口
            pass
        try:
            proc = subprocess.Popen([GUI, '--passive', '--text', text], start_new_session=True)
            with open(PID_FILE, 'w') as f:
                f.write(str(proc.pid))
        except Exception:
            pass


ensure_daemon()
bus.signal_subscribe(None, IFACE, 'Update', PATH, None,
                     Gio.DBusSignalFlags.NONE, on_update)
GLib.timeout_add_seconds(60, ensure_daemon)
GLib.MainLoop().run()
