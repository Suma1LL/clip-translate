#!/usr/bin/env python3
# clip-translate-watch: 订阅 GPaste 剪贴板事件 → 复制英文自动弹翻译窗口（passive 模式，不抢焦点）
# systemd user service: clip-translate-watch.service
# 自愈机制：D-Bus 连接断开或 GPaste 持续不可达时主动退出，由 systemd Restart=always 拉起重建
import os, re, signal, subprocess
from gi.repository import Gio, GLib

GUI = os.path.expanduser('~/.local/bin/clip-translate-gui')
ENABLED_FILE = os.path.expanduser('~/.config/clip-translate.enabled')
REG_DIR = '/tmp/clip-translate-gui.pids'
GPASTE_DAEMON = '/usr/libexec/gpaste/gpaste-daemon'
DEST, PATH, IFACE = 'org.gnome.GPaste', '/org/gnome/GPaste', 'org.gnome.GPaste2'
MAX_LEN = 5000

fail_count = 0
last_seen_text = None  # 上次已知的 GPaste 历史[0]，用于假死恢复后补漏


def is_enabled():
    """总开关：状态文件为 0 时暂停自动翻译（缺省开启，手动窗口不受影响）"""
    try:
        return open(ENABLED_FILE).read().strip() != '0'
    except (OSError, ValueError):
        return True


def is_english(t):
    return bool(re.search(r'[A-Za-z]', t)) and not re.search(r'[一-鿿]', t)


bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)


def gpaste_alive():
    """探活 GPaste（5s 超时，避免卡主循环）"""
    try:
        bus.call_sync(DEST, PATH, IFACE, 'GetHistoryName', None, None,
                      Gio.DBusCallFlags.NONE, 5, None)
        return True
    except Exception as e:
        print('gpaste probe failed: %s' % e, flush=True)
        return False


def spawn_gpaste():
    """dbus activation 失败时的兜底：直接拉起 daemon（继承本服务环境，含 WAYLAND_DISPLAY）"""
    try:
        subprocess.Popen([GPASTE_DAEMON], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print('spawned gpaste-daemon directly', flush=True)
    except Exception as e:
        print('failed to spawn gpaste-daemon: %s' % e, flush=True)


def gpaste_pid():
    """GPaste daemon 的 PID（经 org.freedesktop.DBus 查 name owner），校验 cmdline 防误杀"""
    try:
        owner = bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus',
                              'org.freedesktop.DBus', 'GetNameOwner',
                              GLib.Variant('(s)', (DEST,)), None,
                              Gio.DBusCallFlags.NONE, 5, None).unpack()[0]
        pid = bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus',
                            'org.freedesktop.DBus', 'GetConnectionUnixProcessID',
                            GLib.Variant('(s)', (owner,)), None,
                            Gio.DBusCallFlags.NONE, 5, None).unpack()[0]
        with open('/proc/%d/cmdline' % pid, 'rb') as f:
            if b'gpaste' in f.read():
                return int(pid)
    except Exception as e:
        print('gpaste_pid failed: %s' % e, flush=True)
    return None


def launch_gui(text):
    kill_all_guis()
    try:
        subprocess.Popen([GUI, '--passive', '--text', text], start_new_session=True)
    except Exception as e:
        print('failed to launch GUI: %s' % e, flush=True)


def recover_missed():
    """daemon 假死恢复/重启后：若 GPaste[0] 与上次已知不同，说明错过了一次剪贴板变化，补处理"""
    global last_seen_text
    try:
        text = latest_text().strip()
    except Exception:
        return
    if text != last_seen_text:
        print('recovered missed clipboard change', flush=True)
        last_seen_text = text
        if is_enabled() and text and len(text) <= MAX_LEN and is_english(text):
            launch_gui(text)


def health_check():
    """周期自检（30s）：
    - bus 断开：信号订阅已失效 → 退出让 systemd 重建（新连接+新订阅）
    - GPaste 不可达：先显式拉起；连续 10 次失败 → 退出重启"""
    global fail_count
    if bus.is_closed():
        print('session bus closed, exiting for restart', flush=True)
        os.kill(os.getpid(), signal.SIGTERM)
        return False
    if gpaste_alive():
        fail_count = 0
        recover_missed()
        return True
    fail_count += 1
    if fail_count == 1:
        spawn_gpaste()
    elif fail_count == 3:
        # 持续假死（~90s）：旧 daemon 占着 well-known name，spawn 的新实例起不来。
        # 杀掉假死实例再拉起（GPaste 历史有磁盘持久化，替换不丢）
        pid = gpaste_pid()
        if pid:
            print('killing stuck gpaste-daemon pid=%d' % pid, flush=True)
            try:
                os.kill(pid, signal.SIGKILL)  # 假死实例可能不响应 SIGTERM
            except OSError as e:
                print('kill failed: %s' % e, flush=True)
            GLib.timeout_add_seconds(2, spawn_gpaste)
        else:
            spawn_gpaste()
    if fail_count >= 10:
        print('gpaste unreachable after %d checks, exiting for restart' % fail_count, flush=True)
        os.kill(os.getpid(), signal.SIGTERM)
        return False
    return True


def latest_text():
    res = bus.call_sync(DEST, PATH, IFACE, 'GetElementAtIndex',
                        GLib.Variant('(t)', (0,)), None,
                        Gio.DBusCallFlags.NONE, 5, None)
    return (res.unpack()[1] or '') if res else ''


def kill_all_guis():
    """杀掉所有已注册的翻译窗口（含手动打开的，实现真正的单窗口更新）。
    逐一校验 /proc/<pid>/cmdline，防止 PID 复用误杀无辜进程。"""
    try:
        names = os.listdir(REG_DIR)
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open('/proc/%d/cmdline' % pid, 'rb') as f:
                if b'clip-translate-gui' not in f.read():
                    raise OSError('PID reused')
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        try:
            os.remove(os.path.join(REG_DIR, name))
        except OSError:
            pass


def on_update(conn, sender, path, iface, sig_name, params):
    global last_seen_text
    vals = params.unpack() if params else ()
    if not vals or vals[0] != 'REPLACE':
        return
    try:
        text = latest_text().strip()
    except Exception as e:
        print('latest_text failed: %s' % e, flush=True)
        return
    last_seen_text = text
    if not is_enabled():
        print('event skipped (auto-translate disabled)', flush=True)
        return
    # 单窗口更新：收掉所有已注册窗口（手动+自动），再弹最新内容的窗口
    if text and len(text) <= MAX_LEN and is_english(text):
        launch_gui(text)


signal.signal(signal.SIGCHLD, signal.SIG_IGN)  # 自动回收子进程，防 spawn 的 daemon 退出后变僵尸
print('watch started, pid=%d' % os.getpid(), flush=True)
if not gpaste_alive():
    spawn_gpaste()
try:  # 基线：记录启动时的 GPaste[0]，避免把旧内容当作新事件
    last_seen_text = latest_text().strip()
except Exception:
    last_seen_text = None
bus.signal_subscribe(None, IFACE, 'Update', PATH, None,
                     Gio.DBusSignalFlags.NONE, on_update)
GLib.timeout_add_seconds(30, health_check)
GLib.MainLoop().run()
