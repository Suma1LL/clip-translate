#!/usr/bin/env python3
# 剪贴板翻译 GUI：常驻窗口模式
# - 自动模式：watch 经 unix socket 推送新文本，窗口原地更新（不重开、不跳位置、不抢焦点）
# - 手动模式：GNOME 搜索打开；若已有实例则激活现有窗口并更新
# - 单实例：abstract socket 绑定失败 = 已有实例，转客户端发送文本后退出
# 注：GNOME Wayland 没有置顶协议（set_keep_above 被 Mutter 忽略），
#     因此强制跑在 XWayland 下，用 X11 的 EWMH ABOVE 实现真正的置顶
import os
os.environ.setdefault('GDK_BACKEND', 'x11')
import gi, json, os, re, signal, socket, sys, threading, time, urllib.request
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, Gio, GLib

CONF_PATH = os.path.expanduser('~/.config/clip-translate.conf')
GEOM_FILE = os.path.expanduser('~/.config/clip-translate.geom')
PID_FILE = '/tmp/clip-translate-gui.pid'
SOCK = '\0clip-translate-gui'  # Linux abstract unix socket，进程退出自动消失
LOG_FILE = '/tmp/clip-translate-gui.log'


def log(msg):
    """诊断日志：落盘 + stdout（GNOME 启动的应用 stdout 会被丢弃，落盘才能看到）"""
    try:
        with open(LOG_FILE, 'a') as f:
            f.write('%s pid=%d %s\n' % (time.strftime('%H:%M:%S'), os.getpid(), msg))
    except OSError:
        pass
    print(msg, flush=True)
PROMPT = ('You are a translation engine. Translate the following English text into '
          'concise and natural Chinese. Keep technical terms/code identifiers in English '
          'where appropriate. Output ONLY the translation, no explanations.\n\n')

# (模型ID, 显示名, 是否支持禁用思考)
ENGINES = [
    ('xiaomi/mimo-v2.6-pro', 'MiMo v2.6 Pro（快）', True),
    ('zhipuai/glm-4.6', 'GLM-4.6（稳）', True),
    ('zhipuai/glm-5.3', 'GLM-5.3（强·慢）', False),
]

ENABLED_FILE = os.path.expanduser('~/.config/clip-translate.enabled')


def load_conf():
    conf = {}
    with open(CONF_PATH) as f:
        for line in f:
            m = re.match(r'(\w+)="([^"]*)"', line.strip())
            if m:
                conf[m.group(1)] = m.group(2)
    return conf


def save_model(mid):
    """把选择的引擎写回 conf（保留 BASE_URL/API_KEY 等其它行）"""
    try:
        with open(CONF_PATH) as f:
            lines = f.readlines()
        out, found = [], False
        for ln in lines:
            if ln.startswith('MODEL='):
                out.append('MODEL="%s"\n' % mid)
                found = True
            else:
                out.append(ln)
        if not found:
            out.append('MODEL="%s"\n' % mid)
        with open(CONF_PATH, 'w') as f:
            f.writelines(out)
    except Exception:
        pass


def is_enabled():
    try:
        return open(ENABLED_FILE).read().strip() != '0'
    except (OSError, ValueError):
        return True


def set_enabled(v):
    try:
        with open(ENABLED_FILE, 'w') as f:
            f.write('1' if v else '0')
    except OSError:
        pass


def is_english(t):
    return bool(re.search(r'[A-Za-z]', t)) and not re.search(r'[一-鿿]', t)


def scroll(widget):
    sw = Gtk.ScrolledWindow()
    sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
    sw.set_shadow_type(Gtk.ShadowType.IN)
    sw.add(widget)
    return sw


class TranslateWin(Gtk.Window):
    def __init__(self, conf, text_arg=None, passive=False):
        super().__init__(title='翻译')
        self.conf = conf
        self.gen = 0  # 翻译代际：切换引擎/新文本时+1，旧线程结果自动丢弃
        self.set_default_size(520, 330)
        self.set_keep_above(True)
        # 不隐藏任务栏图标：Dock 常驻图标是最小化后找回窗口的唯一入口
        # （X11 置顶+skip_taskbar 组合下 Mutter 会剥夺最小化能力）
        self.set_position(Gtk.WindowPosition.MOUSE)
        if passive:  # 自动弹窗模式：不抢键盘焦点
            self.set_focus_on_map(False)
        self.connect('key-press-event', self.on_key)
        self.connect('destroy', Gtk.main_quit)
        self.connect('focus-in-event', self.on_focus_in)
        self.connect('configure-event', self.on_configure)
        self._geom_save_id = None

        css = Gtk.CssProvider()
        css.load_from_data(b'textview#src { opacity: 0.65; font-size: 0.92em; }')
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                       margin_top=8, margin_bottom=8, margin_start=10, margin_end=10)
        self.add(vbox)

        # 原文（只读灰色）
        self.src_buf = Gtk.TextBuffer()
        self.src_buf.set_text('(读取中…)')
        src_view = Gtk.TextView(buffer=self.src_buf, editable=False, cursor_visible=False,
                                wrap_mode=Gtk.WrapMode.WORD_CHAR)
        src_view.set_name('src')
        vbox.pack_start(scroll(src_view), True, True, 0)

        vbox.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0)

        # 译文（可选中复制）
        self.dst_buf = Gtk.TextBuffer()
        dst_view = Gtk.TextView(buffer=self.dst_buf, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        dst_view.grab_focus()
        vbox.pack_start(scroll(dst_view), True, True, 1)

        # 按钮行：spinner | 自动开关 | 引擎下拉 | 复制译文
        hbox = Gtk.Box(spacing=6)
        self.spinner = Gtk.Spinner()
        self.spinner.start()
        self.btn_auto = Gtk.Button(label='自动：开' if is_enabled() else '自动：关')
        self.btn_auto.set_tooltip_text('自动弹窗翻译开关：关闭后复制英文不再弹窗，'
                                       '仍可用 GNOME 搜索「翻译」手动打开')
        self.btn_auto.connect('clicked', self.on_auto_clicked)
        self.engine_combo = Gtk.ComboBoxText()
        cur = conf.get('MODEL', ENGINES[0][0])
        for mid, label, _ in ENGINES:
            self.engine_combo.append(mid, label)
        if cur not in [e[0] for e in ENGINES]:  # conf 里手改过其它模型：原样加为选项
            self.engine_combo.append(cur, cur)
        self.engine_combo.set_active_id(cur)
        self.engine_combo.connect('changed', self.on_engine_changed)
        self.engine_combo.set_tooltip_text('切换翻译引擎：立即重译并记住选择')
        self.btn_copy = Gtk.Button(label='复制译文')
        self.btn_copy.connect('clicked', self.on_copy)
        hbox.pack_start(self.spinner, False, False, 0)
        hbox.pack_start(self.btn_auto, False, False, 0)
        hbox.pack_start(self.engine_combo, False, False, 0)
        hbox.pack_end(self.btn_copy, False, False, 0)
        vbox.pack_start(hbox, False, False, 0)

        self.show_all()
        self.restore_geometry()
        if text_arg is not None:
            self.src_text = text_arg.strip()
            self.src_buf.set_text(self.src_text[:3000] if self.src_text else '(剪贴板为空)')
            self.after_text_ready()
        else:
            GLib.idle_add(self.fetch_text)

    def refresh_auto_label(self):
        """按状态文件刷新按钮文案，避免外部改动导致按钮显示与真实状态不一致"""
        try:
            self.btn_auto.set_label('自动：开' if is_enabled() else '自动：关')
        except Exception:
            pass

    def on_focus_in(self, *args):
        self.refresh_auto_label()
        return False

    def restore_geometry(self):
        """恢复上次窗口位置/大小（无记录时保持 MOUSE 定位）"""
        try:
            x, y, w, h = [int(v) for v in open(GEOM_FILE).read().split()]
            self.resize(w, h)
            self.move(x, y)
        except Exception:
            pass

    def on_configure(self, *args):
        if self._geom_save_id:
            GLib.source_remove(self._geom_save_id)
        self._geom_save_id = GLib.timeout_add(1000, self.save_geometry)
        return False

    def save_geometry(self):
        self._geom_save_id = None
        try:
            x, y = self.get_position()
            w, h = self.get_size()
            with open(GEOM_FILE, 'w') as f:
                f.write('%d %d %d %d\n' % (x, y, w, h))
        except Exception:
            pass
        return False

    def fetch_text(self):
        log('fetch_text: start')
        text = ''
        # 1) 问 GPaste 要最新条目（D-Bus，不依赖 GDK 的 Wayland selection 时序）
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            res = bus.call_sync('org.gnome.GPaste', '/org/gnome/GPaste',
                                'org.gnome.GPaste2', 'GetElementAtIndex',
                                GLib.Variant('(t)', (0,)), None,
                                Gio.DBusCallFlags.NONE, 5, None)
            text = (res.unpack()[1] or '').strip()
        except Exception as e:
            log('fetch_text: gpaste failed: %s' % e)
        # 2) fallback：GDK 读（此时窗口已映射，可正常读取）
        if not text:
            log('fetch_text: falling back to GDK clipboard')
            cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            text = (cb.wait_for_text() or '').strip()
        log('fetch_text: got %d chars' % len(text))
        self.src_text = text
        self.src_buf.set_text(text[:3000] if text else '(剪贴板为空)')
        log('fetch_text: src_buf updated, calling after_text_ready')
        self.after_text_ready()
        log('fetch_text: after_text_ready returned')
        return False

    def after_text_ready(self):
        log('after_text_ready: english=%s len=%d' % (is_english(self.src_text or ''), len(self.src_text or '')))
        if self.src_text and is_english(self.src_text):
            self.retranslate()
        else:
            self.spinner.stop()
            self.dst_buf.set_text('(剪贴板内容不是英文，已跳过翻译)' if self.src_text else '(剪贴板为空)')

    def show_new_text(self, text, present):
        """socket 推送的新内容：原地更新（present=手动触发时前置窗口）"""
        log('show_new_text: present=%s len=%d' % (present, len(text)))
        self.refresh_auto_label()
        if present:
            self.present()
        else:
            # 自动模式：仅当窗口被最小化时才还原，已可见则完全不动（不闪烁、不抢焦点）。
            # 注意不能用 deiconify()：X11 下被 WM 最小化的窗口 widget 仍视为 mapped，
            # GTK 会直接早退导致还原失败，还会触发 _NET_WM_STATE_DEMANDS_ATTENTION
            # （Dock 图标弹跳闪烁）；present() 走 _NET_ACTIVE_WINDOW 能可靠还原，
            # 且配合 focus_on_map=False 不会抢键盘焦点。
            w = self.get_window()
            iconified = False
            if w is not None:
                try:
                    iconified = bool(w.get_state() & Gdk.WindowState.ICONIFIED)
                except Exception:
                    pass
            log('show_new_text: iconified=%s' % iconified)
            if iconified:
                self.present()
        if text:
            self.src_text = text.strip()
            self.src_buf.set_text(self.src_text[:3000] if self.src_text else '(剪贴板为空)')
            self.after_text_ready()
        else:
            GLib.idle_add(self.fetch_text)
        return False

    def on_engine_changed(self, combo):
        save_model(combo.get_active_id())  # 记住选择
        if self.src_text and is_english(self.src_text):
            self.retranslate()

    def on_auto_clicked(self, btn):
        new = not is_enabled()
        set_enabled(new)
        btn.set_label('自动：开' if new else '自动：关')

    def retranslate(self):
        # 主线程先抓取引擎参数，worker 线程不碰 GTK 控件
        self.gen += 1
        self.req_model = self.engine_combo.get_active_id()
        self.req_no_think = any(m == self.req_model and dis for m, _, dis in ENGINES)
        self.dst_buf.set_text('')
        self.spinner.start()
        log('retranslate: gen=%d model=%s' % (self.gen, self.req_model))
        threading.Thread(target=self.worker, daemon=True).start()

    def worker(self):
        gen, model, no_think = self.gen, self.req_model, self.req_no_think
        payload = {
            'model': model,
            'max_tokens': 2048, 'stream': True,
            'messages': [{'role': 'user', 'content': PROMPT + self.src_text[:3000]}],
        }
        if no_think:
            payload['thinking'] = {'type': 'disabled'}
        req = urllib.request.Request(
            self.conf['BASE_URL'].rstrip('/') + '/v1/messages',
            data=json.dumps(payload).encode(),
            headers={'x-api-key': self.conf['API_KEY'],
                     'anthropic-version': '2023-06-01',
                     'content-type': 'application/json'})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                for raw in r:
                    line = raw.decode('utf-8', 'replace').strip()
                    if not line.startswith('data:'):
                        continue
                    data = line[5:].strip()
                    if data == '[DONE]':
                        break
                    try:
                        obj = json.loads(data)
                    except json.JSONDecodeError:
                        continue
                    if obj.get('type') == 'content_block_delta':
                        delta = obj.get('delta', {})
                        if delta.get('type') == 'text_delta' and delta.get('text'):
                            GLib.idle_add(self.append, gen, delta['text'])
                    elif obj.get('type') == 'error':
                        msg = json.dumps(obj.get('error', {}), ensure_ascii=False)
                        GLib.idle_add(self.append, gen, '\n[错误] ' + msg)
                        break
        except Exception as e:
            log('worker: request failed: %s' % e)
            GLib.idle_add(self.append, gen, '\n[错误] %s' % e)
        GLib.idle_add(self.stop_spinner, gen)
        log('worker: finished (gen=%d)' % gen)

    def append(self, gen, text):
        if gen != self.gen:
            return False  # 已有新内容/新引擎，旧结果丢弃
        self.dst_buf.insert(self.dst_buf.get_end_iter(), text)
        return False

    def stop_spinner(self, gen):
        if gen == self.gen:
            self.spinner.stop()
        return False

    def on_copy(self, btn):
        text = self.dst_buf.get_text(self.dst_buf.get_start_iter(),
                                     self.dst_buf.get_end_iter(), False)
        if text.strip():
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
            btn.set_label('已复制 ✓')
            GLib.timeout_add(1200, lambda: (btn.set_label('复制译文'), False)[1])

    def on_key(self, w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False


def try_bind():
    """绑定 abstract socket：成功=本进程为唯一实例，失败=已有实例"""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.bind(SOCK)
        s.listen(4)
        return s
    except OSError:
        s.close()
        return None


def send_to_existing(text, manual):
    """把文本转交给已有实例（manual=True 请求前置窗口）"""
    try:
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        c.settimeout(2)
        c.connect(SOCK)
        c.sendall((b'M' if manual else b'W') + text.encode())
        c.close()
        return True
    except OSError:
        return False


def serve_socket(srv, win):
    """accept 循环：协议 = 1字节标志(M=手动/W=自动) + UTF-8 文本"""
    while True:
        try:
            conn, _ = srv.accept()
        except OSError:
            return

        def handle(conn=conn):
            # 注意：连接必须保持到 deliver 执行完，才能在 ACK 发出后再关闭
            data = b''
            try:
                while len(data) < 60000:
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
            except OSError:
                try:
                    conn.close()
                except OSError:
                    pass
                return
            if not data:
                try:
                    conn.close()
                except OSError:
                    pass
                return
            text = data[1:].decode('utf-8', 'replace')
            manual = data[:1] == b'M'

            def deliver():
                # 在主循环里处理并回 ACK：能回 ACK 才证明 UI 线程是活的
                try:
                    win.show_new_text(text, manual)
                    conn.sendall(b'OK')
                except OSError:
                    pass
                finally:
                    try:
                        conn.close()
                    except OSError:
                        pass
                return False

            GLib.idle_add(deliver)

        threading.Thread(target=handle, daemon=True).start()


if __name__ == '__main__':
    args = sys.argv[1:]
    passive = '--passive' in args
    text_arg = None
    if '--text' in args and args.index('--text') + 1 < len(args):
        text_arg = args[args.index('--text') + 1]
    srv = try_bind()
    if srv is None:
        # 已有常驻实例：转交文本后退出（手动打开→前置窗口；自动→安静更新）
        log('main: existing instance found, forwarding text and exiting')
        send_to_existing(text_arg or '', manual=not passive)
        sys.exit(0)
    log('main: becoming the resident instance (passive=%s text_arg=%s)'
        % (passive, 'yes' if text_arg is not None else 'no'))
    try:
        with open(PID_FILE, 'w') as f:
            f.write(str(os.getpid()))
    except OSError:
        pass
    signal.signal(signal.SIGTERM, lambda *a: Gtk.main_quit())
    win = TranslateWin(load_conf(), text_arg, passive)
    threading.Thread(target=serve_socket, args=(srv, win), daemon=True).start()
    Gtk.main()
    try:  # 只清理属于自己的 PID 文件，避免误删换代后新实例的记录
        if open(PID_FILE).read().strip() == str(os.getpid()):
            os.remove(PID_FILE)
    except OSError:
        pass
