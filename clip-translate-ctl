#!/usr/bin/env bash
# clip-translate-ctl {on|off|restart} — 不经过 GUI 的控制入口（GUI 卡住时的自救通道）
F="$HOME/.config/clip-translate.enabled"
case "$1" in
  off)
    echo 0 > "$F"
    notify-send -i accessories-dictionary "剪贴板翻译" "已暂停自动翻译" 2>/dev/null
    echo "off"
    ;;
  on)
    echo 1 > "$F"
    notify-send -i accessories-dictionary "剪贴板翻译" "已恢复自动翻译" 2>/dev/null
    echo "on"
    ;;
  restart)
    pkill -f '[c]lip-translate-gui' 2>/dev/null
    sleep 0.5
    exec "$HOME/.local/bin/clip-translate-gui"
    ;;
  *)
    echo "用法: clip-translate-ctl {on|off|restart}" >&2
    exit 1
    ;;
esac
